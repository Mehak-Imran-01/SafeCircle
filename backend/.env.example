APP_NAME="SafeCircle Backend API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
DOCS_URL="/api/docs"
OPENAPI_URL="/api/openapi.json"
HOST="127.0.0.1"
PORT=8000

# Neon PostgreSQL Database Connection (asyncpg driver)
# Replace with your Neon connection string in your local .env file
DATABASE_URL="postgresql+asyncpg://<username>:<password>@<ep-sample-pooler.region.aws.neon.tech>/<dbname>?ssl=require"

# JWT Authentication Settings
JWT_SECRET_KEY="generate-a-secure-random-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
